# ============================================================
# Nextcloud stack — .env.template
# Usage: cp .env.template .env  →  fill CHANGEME_* values  →  chmod 600 .env
# Do NOT commit .env (it contains real secrets).
# ============================================================

# === MariaDB ===
MYSQL_ROOT_PASSWORD=CHANGEME_DB_ROOT_PASSWORD
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=CHANGEME_DB_PASSWORD

# === Nextcloud Admin (used only on first-run initialisation) ===
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGEME_ADMIN_PASSWORD

# === Trusted Proxies ===
# Must match the Docker subnet assigned to nextcloud_net.
# Verify after bring-up:
#   docker network inspect nextcloud_nextcloud_net | grep Subnet
# If the subnet differs from 172.22.0.0/16, update this value and re-up nextcloud-app.
TRUSTED_PROXIES=172.22.0.0/16

# === Nextcloud MCP server ===
# Image: ghcr.io/cbcoutinho/nextcloud-mcp-server:latest (hardcoded in docker-compose.yml)
# Nextcloud username for the MCP service account (create via web UI)
NEXTCLOUD_MCP_USER=odysseus-agent
# App password generated in Nextcloud web UI:
#   Settings → Security → App passwords → create "odysseus-agent-mcp"
NEXTCLOUD_APP_PASSWORD=CHANGEME_APP_PASSWORD
# Optional: comma-separated tag names to hide from MCP.
# Uncomment EXCLUDED_TAGS in docker-compose.yml and set here when ready.
# NEXTCLOUD_EXCLUDED_TAGS=agent-hidden
